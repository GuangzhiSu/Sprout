ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-lite-260215
# Facial-expression safety monitoring runs in the browser (@vladmandic/face-api),
# so no server-side vision model or key is required.

# Speech-to-text for voice input (Groq Whisper turbo). The transcript is sent
# on to the Ark coach model above.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
